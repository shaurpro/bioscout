# --- Option A: Gemini API key (fastest way to start) ---
GOOGLE_API_KEY=your-key-from-aistudio.google.com
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# --- Option B: Vertex AI on Google Cloud (use this for the Cloud Run deployment) ---
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Models (change if newer ones are available) ---
BIOSCOUT_LLM_MODEL=gemini-2.5-flash
BIOSCOUT_EMBED_MODEL=gemini-embedding-001

# --- Pricing in USD per 1M tokens, used for cost-per-request. Check the current
#     Vertex AI / Gemini API pricing page and update these. ---
BIOSCOUT_PRICE_IN=0.30
BIOSCOUT_PRICE_OUT=2.50
